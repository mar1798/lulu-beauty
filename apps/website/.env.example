# Base URL of your WordPress backend (used for public API requests)
NEXT_PUBLIC_WP_BASE_URL=

# Public URL of your frontend app (e.g., https://lulubeauty.com)
NEXT_PUBLIC_APP_URL=

# reCAPTCHA v3 site key used on the client side
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Tag Manager container ID (e.g., GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics / Universal Analytics ID
NEXT_PUBLIC_UA_ID=

# A fallback base URL for server-side requests when others are undefined
FALLBACK_BASE_URL=

# Base URL of the Lulu Beauty API as seen from the browser.
# Used for /files/* static images; private requests go through /api/proxy/*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Base URL of the same API as seen from the Next server (getStaticProps,
# /api/* routes). Inside docker compose this is http://api:3001.
API_BASE_URL=http://localhost:3001

# Telegram bot username without the leading @ (TELEGRAM_BOT_USERNAME in apps/api/.env).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Show the Telegram Login Widget on /login (one-click sign-in for people who already
# linked the bot). Leave off unless this site's domain is registered with /setdomain in
# BotFather: elsewhere — localhost included — the button renders and then refuses to
# authorize, which is worse than not offering it.
NEXT_PUBLIC_TELEGRAM_LOGIN_WIDGET=false

# Set to false for local http development, so lb_at/lb_rt cookies are sent without Secure.
AUTH_COOKIE_SECURE=true
