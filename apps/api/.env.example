# Local (non-Docker) defaults. Copy to .env: cp .env.example .env
PORT=3001

# For local `uv run uvicorn app.main:app --reload` against the Postgres container exposed on
# the host, use localhost. Inside docker-compose, the api service overrides this to use the
# `db` hostname instead.
DATABASE_URL=postgresql+asyncpg://lulu:lulu@localhost:5432/lulu

# Used by the docker-compose `db` service to initialize Postgres.
POSTGRES_USER=lulu
POSTGRES_PASSWORD=lulu
POSTGRES_DB=lulu

ENVIRONMENT=development
# Origin allowed by CORS to call this API (the website dev server).
CORS_ORIGIN=http://localhost:3000

# Public address of the website, used for the bot's link buttons. Telegram rejects a url
# button pointing at localhost, so those buttons are simply omitted in local dev.
WEBSITE_BASE_URL=http://localhost:3000

# Generate real secrets for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-32-bytes-min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-bytes-min
JWT_REFRESH_TTL_SECONDS=2592000

AUTH_SESSION_TTL_SECONDS=300

# Create a bot via @BotFather to get a real token/username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Webhook instead of polling. Needs a public HTTPS address, so it stays off locally —
# with it off, the bot long-polls exactly as before and POST /telegram/webhook 404s.
# All three go together: a url without a secret is an endpoint anyone who guesses the
# path can post updates to, and the bot refuses that configuration (falls back to polling).
# TELEGRAM_WEBHOOK_URL is the API's public base — the /telegram/webhook path is appended.
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Seeds the single ADMIN owner account (uv run python -m app.scripts.seed).
OWNER_PHONE=
OWNER_NAME=

CYCLE_TIMEZONE=Asia/Bishkek
CURRENCY=KGS

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_FILES_BASE_URL=http://localhost:3001/files

# DB sweeps: reminders (24h before deadline), cycle close + cart cleanup, expired login-session cleanup.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300

# Per-caller HTTP budgets. The general one covers a page of catalog plus its images;
# the auth one covers signing in, which is the only anonymous surface here that writes
# to the database (POST /auth/telegram/session inserts a row and asks nothing of the
# caller). Authenticated requests are counted per account, anonymous ones per address.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
# Whether X-Forwarded-For may be believed when identifying an anonymous caller. The
# website's proxy sets it (see apps/website TRUST_PROXY_HEADERS), so leave it on while
# the API is only reachable through that proxy. Turn it off if the API is exposed
# directly: the header is then attacker-chosen, i.e. an unlimited supply of identities.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
