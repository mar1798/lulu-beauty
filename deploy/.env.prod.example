# Production variables. Copy to the repository root and fill in:
#
#   cp deploy/.env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# The file is used three times: compose substitutes ${...} from it into
# docker-compose.prod.yml, the whole file goes into the api container as an
# env_file, and the scripts under deploy/ read single values out of it with sed
# (SITE_DOMAIN, BACKUP_REMOTE). Write literal values — don't rely on ${...}
# expansion inside a value, the behaviour depends on the compose version, and
# the sed readers don't expand anything at all.
#
# The file holds secrets and is not committed (.gitignore/.dockerignore).

# --- Domain and TLS ----------------------------------------------------------
# The domain must already point at the server with an A/AAAA record: Caddy
# requests a certificate on first start and is refused without working DNS.
SITE_DOMAIN=lulubeauty.example
ACME_EMAIL=you@example.com

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=lulu
POSTGRES_PASSWORD=
POSTGRES_DB=lulu
# DATABASE_URL isn't needed here: docker-compose.prod.yml builds it from the
# three variables above and the `db` host.

# --- JWT secrets -------------------------------------------------------------
# One command per secret: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Addresses (as seen from outside) ----------------------------------------
ENVIRONMENT=production
# The CORS boundary and the public address of the site — identical, but separate.
CORS_ORIGIN=https://lulubeauty.example
WEBSITE_BASE_URL=https://lulubeauty.example
# The prefix of the photo addresses stored in the database. Must be exactly
# `https://<SITE_DOMAIN>/files` — apps/website/src/components/Image.tsx strips
# precisely this prefix to make the image same-origin.
PUBLIC_FILES_BASE_URL=https://lulubeauty.example/files

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Without the @. Goes both to the backend and into the frontend build (NEXT_PUBLIC_*).
TELEGRAM_BOT_USERNAME=
# A webhook instead of long polling: the address is public in production, so the
# extra polling loop is pointless. All three are required together — given a url
# without a secret the bot refuses and falls back to polling.
TELEGRAM_USE_WEBHOOK=true
# The base the bot appends /telegram/webhook to (Caddy lets that path into the API).
TELEGRAM_WEBHOOK_URL=https://lulubeauty.example
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# The "Log in with Telegram" button on /login. Turn it on once the domain is
# registered with the bot in BotFather (Bot Settings → Login Widget → Allowed
# URLs); otherwise the button renders and then refuses to authorize.
NEXT_PUBLIC_TELEGRAM_LOGIN_WIDGET=true

# --- Owner -------------------------------------------------------------------
# The ADMIN account created by `python -m app.scripts.seed` (Step 7 in
# docs/deployment.md).
OWNER_PHONE=
OWNER_NAME=

# --- Backups -----------------------------------------------------------------
# Read by deploy/backup.sh (neither compose nor the api uses it). The rclone
# remote the archives are uploaded to; empty means they stay on this server,
# and the script says so on every run. Configure the remote itself in
# ~/.config/rclone/rclone.conf as `deploy` — Step 9 in docs/deployment.md.
BACKUP_REMOTE=

# --- Everything else ---------------------------------------------------------
CYCLE_TIMEZONE=Asia/Bishkek
CURRENCY=KGS
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
# The API is closed from outside (only /telegram/webhook is exposed) and the
# header is set by Caddy → Next, so it can be trusted.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
