# Продовые переменные. Скопировать в корень репозитория и заполнить:
#
#   cp deploy/.env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Файл используется дважды: compose подставляет из него ${...} в
# docker-compose.prod.yml, и он же целиком уходит в контейнер api как env_file.
# Значения писать литералами — подстановку ${...} внутри значений закладывать
# не стоит, поведение зависит от версии compose.
#
# Файл содержит секреты и в git не коммитится (.gitignore/.dockerignore).

# --- Домен и TLS -------------------------------------------------------------
# Домен уже должен A/AAAA-записью указывать на сервер: Caddy выпускает
# сертификат при первом старте и без работающего DNS получит отказ.
SITE_DOMAIN=lulubeauty.example
ACME_EMAIL=you@example.com

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=lulu
POSTGRES_PASSWORD=
POSTGRES_DB=lulu
# DATABASE_URL здесь не нужен: docker-compose.prod.yml собирает его сам из
# трёх переменных выше и хоста `db`.

# --- Секреты JWT -------------------------------------------------------------
# По одному на каждый: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Адреса (видимые снаружи) ------------------------------------------------
ENVIRONMENT=production
# Граница CORS и публичный адрес сайта — совпадают, но живут отдельно.
CORS_ORIGIN=https://lulubeauty.example
WEBSITE_BASE_URL=https://lulubeauty.example
# Префикс сохранённых в БД адресов фотографий. Обязан быть
# `https://<SITE_DOMAIN>/files` — ровно этот префикс отрезает
# apps/website/src/components/Image.tsx, чтобы картинка стала same-origin.
PUBLIC_FILES_BASE_URL=https://lulubeauty.example/files

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Без @. Уходит и в бэкенд, и в сборку фронта (NEXT_PUBLIC_*).
TELEGRAM_BOT_USERNAME=
# Вебхук вместо long polling: в проде адрес публичный, лишний цикл опроса не нужен.
# Все три обязательны вместе — с url без секрета бот откажется и вернётся к polling.
TELEGRAM_USE_WEBHOOK=true
# База, к которой бот дописывает /telegram/webhook (этот путь Caddy пускает в API).
TELEGRAM_WEBHOOK_URL=https://lulubeauty.example
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Кнопка «Log in with Telegram» на /login. Включать после того, как домен
# зарегистрирован боту через /setdomain в BotFather, иначе кнопка откажет.
NEXT_PUBLIC_TELEGRAM_LOGIN_WIDGET=true

# --- Владелец ----------------------------------------------------------------
# Аккаунт ADMIN, который создаёт `python -m app.scripts.seed` (см. README ниже).
OWNER_PHONE=
OWNER_NAME=

# --- Прочее ------------------------------------------------------------------
CYCLE_TIMEZONE=Asia/Bishkek
CURRENCY=KGS
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
# API снаружи закрыт (наружу торчит только /telegram/webhook), заголовок ему
# ставит Caddy → Next, поэтому ему можно верить.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
