{
	# Where Let's Encrypt writes about problems renewing the certificate.
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# The request body ceiling, first of three: Caddy cuts the connection without
	# passing the bytes to Next, which streams them into the API
	# (bodyParser: false), and the API adds its own BodySizeLimitMiddleware. It is
	# needed here specifically because FastAPI parses a multipart upload before
	# require_admin runs — without an outer limit an anonymous POST writes to disk.
	#
	# ⚠️ This one is the outermost, so it must stay the *widest*: one MiB above
	# MAX_BODY_BYTES (20 MiB) in app/common/body_limit.py, and never below it.
	# Every limit below this one refuses with a machine code that
	# apps/website/src/services/apiErrors.ts turns into a sentence naming the
	# limit — `image_too_large` at 15 MB, `import_file_too_large` at 10 MB,
	# `request_body_too_large` at 20 MiB from the middleware itself. Caddy alone
	# refuses with a bare 413 carrying no code, so whatever it cuts reaches the
	# owner as an unexplained failure. That is what a 12MB ceiling here did to
	# every photo between 12 and 15 MB — which is an ordinary phone camera —
	# while the form, the error text and the API all promised 15. At exactly
	# 20 MiB the same thing would happen to `request_body_too_large`: equal
	# limits mean Caddy gets there first, so the gap is deliberate.
	request_body {
		max_size 21MiB
	}

	# The only path that leads into the API directly: Telegram has to reach the
	# webhook itself, and it will not go through Next's proxy.
	#
	# Everything else in the API is deliberately closed from outside — the browser
	# reaches it through Next's own /api/proxy/*, which attaches the httpOnly
	# cookies. Expose the API wholesale and those cookies stop being the only way in.
	#
	# The path matches what the bot registers: TELEGRAM_WEBHOOK_URL is the base
	# that app/telegram/bot.py appends /telegram/webhook to.
	handle /telegram/webhook {
		reverse_proxy api:3001
	}

	handle {
		# Product photos (/files/*) come here too: Next rewrites them onto the API
		# itself (see next.config.js), so they need no route of their own.
		reverse_proxy website:3000
	}

	# Security headers (CSP, HSTS, Permissions-Policy) are set by Next itself in
	# next.config.js — duplicating them here means drifting apart from it one day.

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
